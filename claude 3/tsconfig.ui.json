{
 "compilerOptions": {
  "target": "ES2022",
  "lib": [
   "dom",
   "dom.iterable",
   "esnext"
  ],
  "module": "commonjs",
  "strict": true,
  "skipLibCheck": true,
  "esModuleInterop": true,
  "outDir": "/tmp/out2",
  "rootDir": ".",
